<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white"
    android:minWidth="300dp">

	<TextView
		android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        android:textColor="@android:color/black" />

	<AutoCompleteTextView
        android:id="@+id/etSchool"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="School Name"
        android:inputType="textCapWords"
        android:completionThreshold="1"
        android:layout_marginBottom="10dp" />

	<EditText
        android:id="@+id/etTown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Town"
        android:inputType="textCapWords"
        android:layout_marginBottom="10dp" />

	<EditText
        android:id="@+id/etBusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bus Line Name (e.g. Line 15)"
        android:inputType="textCapWords"
        android:layout_marginBottom="10dp" />

	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="עצירה ראשונה (אופציונלי)"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="6dp" />

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

		<EditText
            android:id="@+id/etFirstStopLat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="קו רוחב (Lat)"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginEnd="8dp" />

		<EditText
            android:id="@+id/etFirstStopLng"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="קו אורך (Lng)"
            android:inputType="numberDecimal|numberSigned" />
	</LinearLayout>

	<Button
        android:id="@+id/btnPickLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בחר מיקום על המפה"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:textColor="@color/colorAccent"
        android:layout_marginBottom="12dp" />

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

		<Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ביטול"
            style="@style/Widget.AppCompat.Button.Borderless" />

		<Button
            android:id="@+id/btnSaveBus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שמור"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white" />
	</LinearLayout>
</LinearLayout>