<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:layoutDirection="rtl">

    <!-- Status bar (bottom, fixed anchor) -->
    <TextView
        android:id="@+id/globalStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#333333"
        android:gravity="center"
        android:padding="8dp"
        android:text="Status: Ready"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <!-- Debug simulate button, above status bar -->
    <Button
        android:id="@+id/btnSimulateBus"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_above="@id/globalStatusText"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#FF9800"
        android:text="Simulate Bus (DEBUG)"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <!-- Top panel: greeting + chips + route info box -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#1E293B"
        android:elevation="4dp"
        android:layoutDirection="rtl"
        android:orientation="vertical">

        <!-- Row 1: Greeting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שלום"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />


        </LinearLayout>

        <!-- Row 2: Status chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/chipStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="המתנה"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dot" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipVisibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvVisibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="מוסתר"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/dotVisibility"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dot" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 3: Active route info box -->
        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_info_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_bus_small"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tvNoRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לא נבחר מסלול"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Shadow below top panel -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_below="@id/topContainer"
        android:background="@drawable/shadow_panel_bottom" />

    <!-- Routes section header -->
    <TextView
        android:id="@+id/tvRoutesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topContainer"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="מסלולים"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="end" />

    <!-- Route cards list, fills remaining space between header and simulate button -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cardsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnSimulateBus"
        android:layout_below="@id/tvRoutesHeader"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp" />

</RelativeLayout>
