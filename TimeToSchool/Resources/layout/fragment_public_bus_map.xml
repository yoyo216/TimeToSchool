<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@drawable/bg_top_panel"
        android:elevation="6dp">

        <!-- Always-visible header row: back button + section label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="חזרה"
                app:srcCompat="@drawable/ic_arrow_left"
                app:fabSize="mini"
                app:backgroundTint="@android:color/white"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvHeaderLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:gravity="end"
                android:textAlignment="textEnd" />

        </LinearLayout>

        <!-- Collapsible detail section (3 lines = lines 2–4 of the 4-line panel) -->
        <LinearLayout
            android:id="@+id/llPanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="end"
                android:textAlignment="textEnd" />

            <HorizontalScrollView
                android:id="@+id/hsvEtaChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llEtaChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Grab-handle strip: tap or swipe to expand / collapse the panel -->
        <FrameLayout
            android:id="@+id/flHandleArea"
            android:layout_width="match_parent"
            android:layout_height="20dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_grab_handle" />

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFocusAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="מיקד כל אוטובוסים"
        android:src="@android:drawable/ic_menu_zoom"
        app:fabSize="normal" />

</FrameLayout>
